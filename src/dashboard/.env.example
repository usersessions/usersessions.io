# ==========================================
# USERSESSIONS.IO — ENVIRONMENT CONFIGURATION
# ==========================================

# ── 1. SUPABASE (Database & Auth) ────────────────
NEXT_PUBLIC_SUPABASE_URL="your-project-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── 2. COMPOSIO (Integrations & Autonomous Actions) ──
COMPOSIO_API_KEY="your-composio-api-key"
COMPOSIO_WEBHOOK_SECRET="your-composio-webhook-secret"
# Optional overrides for specific integrations
COMPOSIO_HUBSPOT_CONFIG=""
COMPOSIO_LINEAR_CONFIG=""

# ── 3. AI REASONING ENGINES ──────────────────────
ANTHROPIC_API_KEY="your-anthropic-key"
# Default: claude-haiku-4-5 for first-pass classification (fast, low-cost)
# Override to use a different Haiku variant if needed
ANTHROPIC_HAIKU_MODEL="claude-haiku-4-5"

# Default: claude-sonnet-5 for second-pass reasoning on P0/P1 findings only
# Override to claude-opus-5 for maximum capability on the most critical paths
ANTHROPIC_SONNET_MODEL="claude-sonnet-5"

# Legacy: single-model override kept for backward compat (not used by pipeline)
# ANTHROPIC_MODEL="claude-sonnet-5"

# ── 3.5 AI CRAWLER / SITE AUDIT ──────────────────
SCRAPEGRAPHAI_API_KEY="your-scrapegraphai-key"

# ── 4. EMAIL & NOTIFICATIONS (Resend) ────────────
RESEND_API_KEY="re_..."
RESEND_WEBHOOK_SECRET="wh_sec_..."
RESEND_FROM="UserSessions <notifications@usersessions.io>"
EMAIL_POSTAL_ADDRESS="Your Company Inc, 123 Street, City"
ADMIN_EMAIL="admin@yourdomain.com"

# ── 5. BILLING (Paystack) ────────────────────────
PAYSTACK_SECRET_KEY="sk_..."
PAYSTACK_PUBLIC_KEY="pk_..."
PAYSTACK_WEBHOOK_SECRET="wh_..."

# Subscription Plan Codes (from Paystack Dashboard)
PAYSTACK_PLAN_STARTER_MONTHLY="PLN_..."
PAYSTACK_PLAN_STARTER_ANNUAL="PLN_..."
PAYSTACK_PLAN_PRO_MONTHLY="PLN_..."
PAYSTACK_PLAN_PRO_ANNUAL="PLN_..."
PAYSTACK_PLAN_BUSINESS_MONTHLY="PLN_..."
PAYSTACK_PLAN_BUSINESS_ANNUAL="PLN_..."

# ── 6. CLOUDFLARE R2 (Storage & PDFs) ────────────
R2_ACCOUNT_ID="your-cf-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret"
R2_BUCKET_NAME="usersessions-replays"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# ── 7. WEB PUSH NOTIFICATIONS ────────────────────
# Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:notifications@usersessions.io"

# ── 8. SECURITY & SITE CONFIG ────────────────────
NEXT_PUBLIC_SITE_URL="https://usersessions.io"
CRON_SECRET="generate-a-secure-random-string"
NOTIFY_ACTION_SECRET="generate-another-secure-string"
QSTASH_TOKEN="your-upstash-qstash-token"

# ── 9. SESSION INGESTION WEBHOOKS ────────────────
DATADOG_WEBHOOK_SECRET="your-datadog-secret"
POSTHOG_WEBHOOK_SECRET="your-posthog-secret"
